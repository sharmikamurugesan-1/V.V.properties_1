# V.V Properties Enterprise Environment Configuration
# Copy this file to .env.local for local development. NEVER commit real secrets to Git.

# ==========================================
# 1. SUPABASE ENTERPRISE DATABASE & AUTH
# ==========================================
# Public Supabase Project URL (e.g., https://your-project.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Public Anonymous API Key (used in browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Secret Key (used only on trusted server routes, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# ==========================================
# 2. ADMIN AUTHENTICATION
# ==========================================
# Strong password required for /admin access
ADMIN_PASSWORD=change_this_to_a_strong_password_in_production

# 32+ character random secret key for HMAC-SHA256 session signature
ADMIN_SESSION_SECRET=generate_a_random_32_character_hex_or_base64_secret_here

# ==========================================
# 3. CONTACT & INTEGRATIONS
# ==========================================
# Official WhatsApp Contact (digits only with country code, e.g., 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=919840012345

# Endpoint URL to receive validated leads (CRM, Google Sheets, Make, Zapier, Zoho)
LEAD_WEBHOOK_URL=

# ==========================================
# 4. TELEMETRY & ANALYTICS (Gated by consent)
# ==========================================
# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Meta (Facebook) Pixel ID (e.g., 123456789012345)
NEXT_PUBLIC_META_PIXEL_ID=

# ==========================================
# 5. SITE CANONICAL URL
# ==========================================
# Canonical production site URL
NEXT_PUBLIC_SITE_URL=https://v-v-properties-1.onrender.com

# Strict compliance check in check-content script (0 = standard, 1 = strict fail on missing config)
STRICT_CONTENT=0
